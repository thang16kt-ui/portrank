# Sao chép thành .env (KHÔNG commit file .env) rồi điền giá trị.

# ── Ảnh thực Google Photorealistic 3D Tiles (Map Tiles API, tính phí theo lượt) ──
# Key này nằm trong mã chạy trên trình duyệt (giống Google Maps JS): hãy giới hạn key theo
# HTTP referrer (tên miền của bạn) và chỉ cho phép "Map Tiles API" trong Google Cloud Console.
VITE_GOOGLE_MAPS_KEY=

# ── Định tuyến đường bộ: Google Routes + Google Maps JavaScript ──
# Bật Routes API và thanh toán Google Cloud. Key Routes CHỈ đặt trên máy chủ, không có tiền tố VITE_.
GOOGLE_ROUTES_API_KEY=
# Key công khai RIÊNG cho Maps JavaScript API, giới hạn theo HTTP referrer/tên miền.
# Key này chỉ phục vụ bản đồ đường bộ, không dùng key Map Tiles ở trên.
GOOGLE_MAPS_BROWSER_KEY=

# ── Lịch tàu theo chuẩn DCSA Commercial Schedules 1.0 – CHỈ dùng ở máy chủ (npm start) ──
# Key hãng tàu không bao giờ gửi xuống trình duyệt.
# DCSA_CARRIERS=MAERSK,CMACGM
# DCSA_MAERSK_URL=https://<gốc API do hãng cấp, không gồm /v1/point-to-point-routes>
# DCSA_MAERSK_HEADERS={"Consumer-Key":"<key>"}
# DCSA_CMACGM_URL=https://...
# DCSA_CMACGM_KEY=<key>
# DCSA_CMACGM_KEY_HEADER=KeyId
